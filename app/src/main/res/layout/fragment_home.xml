<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card 1: Offline Account Configuration -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configure Offline Account"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <!-- Username Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.QcofA.TextInputLayout"
                    app:boxBackgroundColor="@color/surface_container_low">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Username"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Expandable Section Header -->
                <LinearLayout
                    android:id="@+id/expandableSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:layout_marginBottom="8dp">

                    <!-- Expand/Collapse Indicator -->
                    <TextView
                        android:id="@+id/expandIndicator"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="▶"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:gravity="center"
                        android:layout_marginEnd="8dp" />

                    <!-- Section Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Advanced Options"
                        android:textSize="16sp"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Expandable Content -->
                <LinearLayout
                    android:id="@+id/expandableSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Custom UUID Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.QcofA.TextInputLayout"
                        app:boxBackgroundColor="@color/surface_container_low">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customUuidInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Custom UUID (leave empty for auto-generate)"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- User Type Spinner Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="User Type"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginBottom="8dp" />

                    <!-- User Type Spinner -->
                    <Spinner
                        android:id="@+id/userTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                    <!-- UUID Display -->
                    <TextView
                        android:id="@+id/uuidDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="UUID: "
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:background="@color/surface_container"
                        android:padding="12dp"
                        android:typeface="monospace" />
                </LinearLayout>

                <!-- Action Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createAccountBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Create Account File"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewAccountsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="View Created Accounts"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2: User Configuration -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User Configuration"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <!-- Checkboxes -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/legalCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accepted Legal Terms (acceptedLegal)"
                    android:checked="true"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/devModsCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Developer Mods (setDevMods)"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/customRamCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom RAM (setCustomRAM)"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="12dp" />

                <!-- Custom RAM Value Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.QcofA.TextInputLayout"
                    app:boxBackgroundColor="@color/surface_container_low">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ramValueInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Custom RAM value (e.g., 2048)"
                        android:inputType="number"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/demoModeCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Demo Mode (isDemoMode)"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="20dp" />

                <!-- Action Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveConfigBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Save Configuration"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manualInstallJreBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Manual JRE Runtime Installation"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
